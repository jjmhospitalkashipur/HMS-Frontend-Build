{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(feature-module)/layout,_N_T_/(feature-module)/contact-messages/layout,_N_T_/(feature-module)/contact-messages/page,_N_T_/contact-messages"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGZlYXR1cmUtbW9kdWxlKQ/contact-messages/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 96,
        "slots": {
          "children": {
            "hints": 96,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  }
}